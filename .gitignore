# Compiled binaries and build output
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
tmp/

# Test output
*.test
*.out
coverage.out
coverage.html

# Go module cache (never commit this)
vendor/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
.DS_Store?
._*
Thumbs.db

# Logs
*.log

# Environment and secrets (NEVER commit these)
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp

# devenv / Nix
# .devenv/ and .direnv/ are generated caches — never commit them.
# devenv.lock and devenv.yaml MUST be committed: they are the reproducibility
# guarantee, equivalent to flake.lock in a pure Nix repo or package-lock.json
# in Node. Committing the lock ensures every developer and CI run gets the
# exact same tool versions.
.devenv/
.devenv.flake.nix
.direnv/
