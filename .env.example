# .env.example — Template for local environment variables.
#
# Copy this file to .env and fill in the values for your local setup.
# .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# devenv loads .env automatically when you enter the shell (dotenv.enable).
# Variables declared here override the defaults devenv sets from devenv.nix.

# Application environment (development | staging | production)
APP_ENV=development

# HTTP server address
# APP_ADDR=:8080

# Add your project-specific variables below.
# Example:
# DATABASE_URL=postgres://user:pass@localhost:5432/mydb
