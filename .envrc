# .envrc — activates the devenv development environment via direnv.
# Setup: bash scripts/bootstrap.sh, then `direnv allow`.

# Guard: fail with a clear message if devenv is missing.
if ! command -v devenv &>/dev/null; then
  echo ""
  echo "ERROR: devenv is not installed."
  echo ""
  echo "Run: bash scripts/bootstrap.sh"
  echo "Then open a new terminal and run: direnv allow"
  echo ""
  return 1
fi

eval "$(devenv direnvrc)"

use devenv
