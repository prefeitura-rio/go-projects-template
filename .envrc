# .envrc — Activates the devenv development environment automatically.
#
# This file is read by direnv (https://direnv.net) whenever you enter
# this directory. It instructs direnv to activate the environment declared
# in devenv.nix, which provides Go, all development tools, and git hooks.
#
# Prerequisites (install once with: bash scripts/bootstrap.sh):
#   - Nix      — the package manager devenv is built on
#   - devenv   — reads devenv.nix and builds the isolated environment
#   - direnv   — watches this .envrc and auto-activates the environment
#
# First-time setup (run once after cloning):
#   bash scripts/bootstrap.sh   # installs Nix, devenv, and direnv
#   direnv allow                 # grants direnv permission to load this file
#
# After that, entering this directory in any terminal activates the
# environment automatically — no manual `devenv shell` needed.

# Guard: check that devenv is installed before trying to use it.
# Without this, the error from `use devenv` is cryptic and unhelpful.
if ! command -v devenv &>/dev/null; then
  echo ""
  echo "ERROR: devenv is not installed."
  echo ""
  echo "Run the bootstrap script to install Nix, devenv, and direnv:"
  echo ""
  echo "  bash scripts/bootstrap.sh"
  echo ""
  echo "Then open a new terminal and run: direnv allow"
  echo ""
  # Return 1 to make direnv report a failure rather than silently doing nothing.
  return 1
fi

# Load devenv's direnv integration.
#
# `devenv direnvrc` prints the shell function `use_devenv`, which is what
# direnv calls when it sees `use devenv` below.
#
# Without this eval, direnv does not know what `use devenv` means and errors
# with "use_devenv: command not found". This is the officially recommended
# approach for devenv 2.x (see: devenv direnvrc --help).
eval "$(devenv direnvrc)"

use devenv
